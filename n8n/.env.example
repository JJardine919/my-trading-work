# n8n Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Database Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=n8n

# MCP Configuration
N8N_MCP_ENABLED=true
N8N_MCP_SERVER_PORT=3000
MCP_BEARER_TOKEN=your_secure_token_here

# Trading API Configuration (customize for your needs)
TRADING_API_KEY=your_api_key
TRADING_API_SECRET=your_api_secret
TRADING_API_URL=https://api.example.com

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret
