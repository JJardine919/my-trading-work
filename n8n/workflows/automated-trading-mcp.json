{
  "name": "Automated Trading with MCP",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "server": "trading-analytics",
        "tool": "get_portfolio_status",
        "parameters": {
          "include_history": true
        }
      },
      "id": "mcp-client-portfolio",
      "name": "Get Portfolio Status",
      "type": "n8n-nodes-langchain.toolMcp",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "risk-check",
              "leftValue": "={{ $json.risk_level }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "balance-check",
              "leftValue": "={{ $json.available_balance }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-conditions",
      "name": "Check Trading Conditions",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "server": "trading-analytics",
        "tool": "analyze_market_data",
        "parameters": {
          "symbol": "BTCUSD",
          "timeframe": "5m",
          "indicators": ["rsi", "macd", "sma"]
        }
      },
      "id": "mcp-client-analyze",
      "name": "Analyze Market",
      "type": "n8n-nodes-langchain.toolMcp",
      "typeVersion": 1,
      "position": [910, 200]
    },
    {
      "parameters": {
        "jsCode": "// Trading decision logic\nconst analysis = $json;\nconst portfolio = $node['Get Portfolio Status'].json;\n\n// Decision criteria\nlet shouldTrade = false;\nlet tradeDecision = {};\n\nif (analysis.recommendation === 'BUY' && analysis.confidence > 0.7) {\n  shouldTrade = true;\n  tradeDecision = {\n    symbol: analysis.symbol,\n    side: 'buy',\n    quantity: portfolio.available_balance * 0.1, // Use 10% of balance\n    type: 'market',\n    reason: 'Strong bullish signals',\n    confidence: analysis.confidence,\n    timestamp: new Date().toISOString()\n  };\n} else if (analysis.recommendation === 'SELL' && analysis.confidence > 0.7) {\n  // Check if we have positions to sell\n  const position = portfolio.positions?.find(p => p.symbol === analysis.symbol);\n  if (position && position.quantity > 0) {\n    shouldTrade = true;\n    tradeDecision = {\n      symbol: analysis.symbol,\n      side: 'sell',\n      quantity: position.quantity * 0.5, // Sell 50% of position\n      type: 'market',\n      reason: 'Strong bearish signals',\n      confidence: analysis.confidence,\n      timestamp: new Date().toISOString()\n    };\n  }\n}\n\nif (shouldTrade) {\n  return [{ json: tradeDecision }];\n} else {\n  return [];\n}"
      },
      "id": "trading-decision",
      "name": "Trading Decision Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "server": "trading-analytics",
        "tool": "execute_trade",
        "parameters": "={{ $json }}"
      },
      "id": "mcp-client-execute",
      "name": "Execute Trade",
      "type": "n8n-nodes-langchain.toolMcp",
      "typeVersion": 1,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "trade_log",
        "columns": "symbol, side, quantity, type, price, status, timestamp",
        "values": "={{ $json.symbol }}, {{ $json.side }}, {{ $json.quantity }}, {{ $json.type }}, {{ $json.executed_price }}, {{ $json.status }}, {{ $json.timestamp }}"
      },
      "id": "log-trade",
      "name": "Log Trade",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1570, 200]
    },
    {
      "parameters": {
        "content": "No trading conditions met",
        "respondWith": "noData",
        "options": {}
      },
      "id": "skip-trading",
      "name": "Skip Trading",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [910, 400]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Portfolio Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Portfolio Status": {
      "main": [
        [
          {
            "node": "Check Trading Conditions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Trading Conditions": {
      "main": [
        [
          {
            "node": "Analyze Market",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Trading",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Market": {
      "main": [
        [
          {
            "node": "Trading Decision Logic",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trading Decision Logic": {
      "main": [
        [
          {
            "node": "Execute Trade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Trade": {
      "main": [
        [
          {
            "node": "Log Trade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "trading",
      "id": "1"
    },
    {
      "name": "mcp",
      "id": "2"
    },
    {
      "name": "automated",
      "id": "3"
    }
  ],
  "meta": {
    "instanceId": "trading-instance"
  }
}
