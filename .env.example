# n8n MCP Configuration
# Copy this file to .env and fill in your values

# n8n API Configuration
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Instructions:
# 1. Get your n8n API key from: n8n instance -> Settings -> API
# 2. Copy this file to .env: cp .env.example .env
# 3. Replace 'your_n8n_api_key_here' with your actual API key
# 4. Update N8N_API_URL if your n8n instance is running on a different URL
