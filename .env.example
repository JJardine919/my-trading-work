# N8N Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=your_encryption_key_here_min_32_chars

# Webhook URL (change to your domain if deploying publicly)
WEBHOOK_URL=http://localhost:5678

# Timezone
TIMEZONE=America/New_York

# PostgreSQL Database Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=n8n

# Third-party API Credentials (for workflows)
# Airtable
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=appXXXXXXX

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Stripe
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Google Sheets
GOOGLE_SHEETS_CLIENT_ID=your_google_client_id_here
GOOGLE_SHEETS_CLIENT_SECRET=your_google_client_secret_here
