# n8n Environment Configuration

# SQLite Configuration
DB_SQLITE_POOL_SIZE=5

# Task Runners (Future-proof)
N8N_RUNNERS_ENABLED=true

# Security Settings
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# n8n Basic Settings
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost

# Use existing n8n data directory (uncomment and set path)
# N8N_USER_FOLDER=/path/to/your/existing/.n8n
